{
	"name": "pihurl-server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "pihurl backend: orchestrates pi (RPC) and Hurl, streams chat to the browser over SSE.",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"start": "node dist/server.js",
		"dev": "node --import tsx src/server.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "npm run build && node --test test/*.test.mjs"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^1.0.0",
		"@hono/node-server": "^1.13.0",
		"hono": "^4.6.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0"
	}
}
